# ==============================================================================
# Sri Vijaya Lakshmi Hospital — Production Docker Deployment Configuration (.env)
# ==============================================================================
# Copy this file to .env on your deployment server:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Project & Port Configuration
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=svlh
FRONTEND_PORT=94
BACKEND_PORT=5011
MONGO_PORT=27027

# ------------------------------------------------------------------------------
# 2. Application & Database Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
MONGO_INITDB_DATABASE=svlh_hospital_db
# In Docker compose, backend connects to the mongo container by service name:
MONGO_URI=mongodb://mongo:27017/svlh_hospital_db
CORS_ORIGIN=*
PUBLIC_APP_URL=http://localhost:94

# ------------------------------------------------------------------------------
# 3. Security Keys & Secrets (GENERATE STRONG SECRETS FOR PRODUCTION)
# ------------------------------------------------------------------------------
JWT_SECRET=svlh_production_jwt_secret_key_2026_x89_hospital_grade
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=svlh_production_refresh_token_secret_key_2026_x89
REFRESH_TOKEN_EXPIRES_IN=30d
FIELD_ENCRYPTION_KEY=aHBtYnNfYWVzMjU2X2VuY3J5cHRpb25fa2V5XzMyYiE=
SEARCH_HASH_KEY=svlh_search_hash_secret_key_2026_production_safe_key_32b

# ------------------------------------------------------------------------------
# 4. Email Configuration (Optional)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@srivijayalakshmihospital.com
